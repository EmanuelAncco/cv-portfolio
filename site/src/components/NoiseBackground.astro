<!-- Film-grain noise canvas — fixed background, barely visible, adds engineer texture -->
<canvas
  id="noise-bg"
  class="fixed inset-0 pointer-events-none"
  style="z-index: -10; opacity: 0.025;"
  aria-hidden="true"
></canvas>
<script>
  const c = document.getElementById('noise-bg') as HTMLCanvasElement | null;
  if (c) {
    const ctx = c.getContext('2d');
    if (ctx) {
      function resize() {
        c!.width = window.innerWidth;
        c!.height = window.innerHeight;
      }
      function noise() {
        const w = c!.width;
        const h = c!.height;
        const id = ctx!.createImageData(w, h);
        const d = id.data;
        for (let i = 0; i < d.length; i += 4) {
          const v = (Math.random() * 255) | 0;
          d[i] = d[i + 1] = d[i + 2] = v;
          d[i + 3] = 255;
        }
        ctx!.putImageData(id, 0, 0);
      }
      resize();
      noise();
      // Animate film grain at ~10fps to avoid perf hit
      setInterval(noise, 100);
      window.addEventListener('resize', () => { resize(); noise(); });
    }
  }
</script>
