---
const skills = [
  "Astro", "TypeScript", "PyTorch", "YOLOv8", "Three.js",
  "Verilog", "FPGA Gowin", "Godot 4", "FastAPI", "n8n",
  "Cloudflare", "Postgres", "OpenSees", "Revit API", "Blender",
  "Docker", "LaTeX", "Next.js", "React", "Python",
];
---
<section class="py-16 border-y border-[var(--color-rule)] reveal" aria-label="Stack técnico">
  <div class="max-w-[var(--container-1100)] mx-auto px-6">
    <p class="font-[var(--font-tech)] text-[10px] uppercase tracking-widest text-[var(--color-text-dim)] mb-6">
      stack
    </p>
    <p class="font-[var(--font-tech)] text-sm md:text-base leading-relaxed text-[var(--color-text-dim)]">
      <span class="text-[var(--color-accent)]">$</span>
      <span class="text-[var(--color-text-dim)]"> emanuel --skills</span>
      <br />
      {skills.map((s, i) => (
        <>
          <span class="text-[var(--color-text)]">{s}</span>
          {i < skills.length - 1 && <span class="text-[var(--color-rule)]"> · </span>}
        </>
      ))}
      <span
        class="inline-block w-[0.55em] h-[1em] bg-[var(--color-accent)] ml-1 align-middle"
        style="animation: blink 1.1s step-end infinite;"
        aria-hidden="true"
      ></span>
    </p>
  </div>
</section>

<style>
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0; }
  }
</style>
