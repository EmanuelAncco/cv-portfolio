---
const year = new Date().getFullYear();
---
<!-- Decorative display watermark -->
<div class="relative overflow-hidden mt-32 select-none pointer-events-none" aria-hidden="true">
  <p
    class="font-[var(--font-display)] font-black text-center leading-none whitespace-nowrap"
    style="font-size: clamp(3.5rem, 11vw, 10rem); color: rgba(245,158,11,0.05); letter-spacing: -0.02em;"
  >
    CIVIL · IA · HARDWARE
  </p>
</div>

<footer class="border-t border-[var(--color-rule)] -mt-8 py-12 text-sm text-[var(--color-text-dim)]">
  <div class="max-w-[var(--container-1100)] mx-auto px-6 flex flex-col md:flex-row justify-between gap-4">
    <div class="font-[var(--font-mono)] text-xs">
      © {year} Emanuel Ancco · Construido en Astro · Lima / Puno
    </div>
    <div class="flex gap-6 font-[var(--font-mono)] text-xs">
      <a href="https://github.com/EmanuelAncco" class="hover:text-[var(--color-accent)] transition-colors">GitHub</a>
      <a href="https://www.linkedin.com/in/emanuel-ancco/" class="hover:text-[var(--color-accent)] transition-colors">LinkedIn</a>
      <a href="/contacto" class="hover:text-[var(--color-accent)] transition-colors">Contacto</a>
    </div>
  </div>
</footer>
