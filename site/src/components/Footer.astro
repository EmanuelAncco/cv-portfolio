---
// Dense info-block footer — no watermark, no big decorative text
---
<footer class="border-t border-[var(--color-rule)] mt-32 py-16 font-[var(--font-mono)] text-xs">
  <div class="max-w-[var(--container-1100)] mx-auto px-6 grid sm:grid-cols-2 md:grid-cols-4 gap-8 text-[var(--color-text-dim)]">

    <div>
      <p class="text-[var(--color-text)] uppercase tracking-widest mb-3">contacto</p>
      <a
        href="mailto:coarp.eancco@gmail.com"
        class="block hover:text-[var(--color-accent)] transition-colors mb-1"
      >
        coarp.eancco[at]gmail.com
      </a>
      <a
        href="https://github.com/EmanuelAncco"
        target="_blank"
        rel="noopener noreferrer"
        class="block hover:text-[var(--color-accent)] transition-colors mb-1"
      >
        github · EmanuelAncco
      </a>
      <a
        href="https://www.linkedin.com/in/emanuel-ancco/"
        target="_blank"
        rel="noopener noreferrer"
        class="block hover:text-[var(--color-accent)] transition-colors"
      >
        linkedin · emanuel-ancco
      </a>
    </div>

    <div>
      <p class="text-[var(--color-text)] uppercase tracking-widest mb-3">ubicación</p>
      <p>Lima · Puno · Perú</p>
      <p class="mt-1">UTC−5</p>
    </div>

    <div>
      <p class="text-[var(--color-text)] uppercase tracking-widest mb-3">stack del sitio</p>
      <p>Astro 6 · Tailwind 4</p>
      <p class="mt-1">GSAP · Lenis</p>
      <p class="mt-1">Cloudflare Pages</p>
      <a
        href="https://github.com/EmanuelAncco/cv-portfolio"
        target="_blank"
        rel="noopener noreferrer"
        class="block mt-1 hover:text-[var(--color-accent)] transition-colors"
      >
        source on github
      </a>
    </div>

    <div>
      <p class="text-[var(--color-text)] uppercase tracking-widest mb-3">build</p>
      <p>v2.0 · 2026</p>
      <p class="mt-1">© Emanuel Ancco</p>
      <p class="mt-3 text-[var(--color-rule)]">Ing. Civil · IA · Hardware</p>
    </div>

  </div>
</footer>
