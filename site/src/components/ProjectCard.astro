---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

interface Props {
  proyecto: CollectionEntry<"proyectos">;
  variant?: "default" | "compact";
}
const { proyecto, variant = "default" } = Astro.props;
const { titulo, anio, stack, metricas, excerpt, hero } = proyecto.data;
const slug = proyecto.id.replace(/\.md$/, "");
---
<article
  class={variant === "compact"
    ? "border-b border-[var(--color-rule)] py-6"
    : "border-b border-[var(--color-rule)] py-10 group project-card"}
>
  {variant === "default" && hero && (
    <div class="mb-6 overflow-hidden border border-[var(--color-rule)] relative project-thumb">
      <a href={`/proyectos/${slug}`} tabindex="-1" aria-hidden="true" class="block">
        <Image
          src={hero}
          alt={`${titulo} — vista previa`}
          width={800}
          height={450}
          widths={[400, 800, 1200]}
          sizes="(min-width:768px) 800px, 100vw"
          loading="lazy"
          class="w-full h-auto object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]"
          style="display: block;"
        />
      </a>
      <!-- Amber glow overlay on hover -->
      <div
        class="absolute inset-0 pointer-events-none opacity-0 transition-opacity duration-500 group-hover:opacity-100"
        style="box-shadow: inset 0 0 0 1px rgba(245,158,11,0.5), 0 0 40px rgba(245,158,11,0.07);"
        aria-hidden="true"
      ></div>
    </div>
  )}

  <div class="flex items-baseline justify-between gap-6">
    <h3 class="font-[var(--font-display)] text-2xl md:text-3xl leading-tight">
      <a href={`/proyectos/${slug}`} class="hover:text-[var(--color-accent)] transition-colors">
        {titulo}
      </a>
    </h3>
    <span class="font-[var(--font-mono)] text-xs text-[var(--color-text-dim)] shrink-0">{anio}</span>
  </div>

  <p class="mt-3 text-[var(--color-text-dim)] max-w-2xl">{excerpt}</p>

  {variant === "default" && metricas.length > 0 && (
    <dl class="mt-4 flex flex-wrap gap-x-8 gap-y-2 font-[var(--font-mono)] text-xs">
      {metricas.map((m) => (
        <div class="flex flex-col">
          <dt class="text-[var(--color-text-dim)] uppercase tracking-wider">{m.label}</dt>
          <dd class="text-[var(--color-accent)]">{m.valor}</dd>
        </div>
      ))}
    </dl>
  )}

  {stack.length > 0 && (
    <div class="mt-3 flex flex-wrap gap-2 text-xs text-[var(--color-text-dim)]">
      {stack.map((s) => (
        <span class="font-[var(--font-mono)] border border-[var(--color-rule)] px-2 py-0.5 text-[10px] uppercase tracking-wider">
          {s}
        </span>
      ))}
    </div>
  )}
</article>
