---
// Inline terminal-style data row — no glass card, reads like a status line
---
<div class="border-y border-[var(--color-rule)] py-3 mt-12 overflow-x-auto reveal">
  <div class="max-w-[var(--container-1100)] mx-auto px-6 flex gap-6 md:gap-8 font-[var(--font-mono)] text-xs uppercase tracking-widest text-[var(--color-text-dim)] whitespace-nowrap items-center">
    <span>
      <span data-count="12" class="text-[var(--color-accent)] tabular-nums">12</span>
      <span class="ml-1">proyectos</span>
    </span>
    <span class="text-[var(--color-rule)] select-none">//</span>
    <span>
      <span data-count="4" class="text-[var(--color-accent)] tabular-nums">4</span>
      <span class="ml-1">ejes</span>
    </span>
    <span class="text-[var(--color-rule)] select-none">//</span>
    <span>2024 — 2026</span>
    <span class="text-[var(--color-rule)] select-none">//</span>
    <span>Lima · Puno</span>
    <span class="text-[var(--color-rule)] select-none">//</span>
    <span>1 paper · paper-ready</span>
  </div>
</div>
