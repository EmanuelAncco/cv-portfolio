---
const links = [
  { href: "/#proyectos", label: "Proyectos" },
  { href: "/sobre",      label: "Sobre" },
  { href: "/cv",         label: "CV" },
  { href: "/contacto",   label: "Contacto" },
];
const currentPath = Astro.url.pathname;
---
<nav class="sticky top-0 z-50 border-b border-[var(--color-rule)]"
     style="backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); background: rgba(2,6,23,0.75);">
  <div class="max-w-[var(--container-1100)] mx-auto px-6 py-3.5 flex items-center justify-between">
    <a href="/" class="font-[var(--font-display)] text-lg hover:text-[var(--color-accent)] transition-colors">
      Emanuel Ancco
    </a>
    <div class="flex items-center gap-6 font-[var(--font-mono)] text-xs uppercase tracking-wider">
      {links.map((l) => (
        <a
          href={l.href}
          class={`transition-colors hidden sm:block ${
            currentPath === l.href
              ? "text-[var(--color-accent)]"
              : "text-[var(--color-text-dim)] hover:text-[var(--color-text)]"
          }`}
        >
          {l.label}
        </a>
      ))}
      <a
        href="/contacto"
        class="sm:hidden px-4 py-1.5 rounded-full bg-[var(--color-accent)] text-black text-xs font-bold hover:bg-[var(--color-accent-light)] transition-colors"
      >
        Contacto
      </a>
    </div>
  </div>
</nav>
