---
import { Image } from "astro:assets";
import emanuel from "../assets/emanuel.jpg";
---

<!-- Hero A: Photo-as-background-strip — full viewport, editorial title bottom-aligned -->
<section
  id="hero"
  class="relative overflow-hidden"
  style="height: 100vh; min-height: 600px; background: #020617;"
>
  <!-- LEFT STRIP: photo with hard gradient overlay -->
  <div
    class="absolute top-0 left-0 h-full pointer-events-none"
    style="width: 38%; max-width: 560px;"
    aria-hidden="true"
  >
    <Image
      src={emanuel}
      alt=""
      width={560}
      height={900}
      widths={[280, 560, 840]}
      sizes="38vw"
      loading="eager"
      decoding="sync"
      id="hero-photo"
      style="
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center top;
        display: block;
        filter: grayscale(30%) contrast(1.1);
      "
    />
    <!-- gradient: photo fades hard to dark on right edge -->
    <div
      class="absolute inset-0"
      style="background: linear-gradient(to right, rgba(2,6,23,0.05) 0%, rgba(2,6,23,0.55) 60%, rgba(2,6,23,1) 100%);"
    ></div>
    <!-- gradient: fades from dark at top -->
    <div
      class="absolute inset-0"
      style="background: linear-gradient(to bottom, rgba(2,6,23,0.7) 0%, transparent 20%, transparent 75%, rgba(2,6,23,0.8) 100%);"
    ></div>
  </div>

  <!-- RIGHT TWO-THIRDS: editorial content, bottom-aligned -->
  <div
    class="relative h-full flex flex-col justify-end"
    style="padding-left: max(38%, min(38vw, 560px)); padding-right: 5vw; padding-bottom: 8vh;"
  >
    <!-- ID card block — top-left of text column -->
    <div
      class="absolute top-0 font-[var(--font-mono)] text-xs leading-relaxed text-[var(--color-text-dim)]"
      style="left: max(38%, min(38vw, 560px)); padding-left: 2.5vw; padding-top: 7vh;"
    >
      <div id="id-card" class="border-l-2 border-[var(--color-accent)] pl-4 opacity-0">
        <p class="text-[var(--color-text)] font-semibold tracking-widest uppercase text-[11px]">Emanuel Ancco</p>
        <p class="mt-1 tracking-widest">── Ingeniería / IA / Hardware</p>
        <p class="tracking-widest">── Lima · Puno · 2026</p>
        <p class="tracking-widest">── 12 Proy · 4 Ejes · 1 Paper</p>
      </div>
    </div>

    <!-- Main editorial title — bottom-aligned, massive -->
    <div class="pl-[2.5vw]">
      <h1
        id="hero-title"
        class="font-[var(--font-display)] leading-[0.88] tracking-tight text-[var(--color-text)]"
        style="font-size: clamp(3.2rem, 8vw, 7.5rem);"
      >
        <span class="word-fade block">Construyo en el</span>
        <span class="word-fade block">cruce de la <em class="not-italic text-[var(--color-accent)]">ingeniería</em>,</span>
        <span class="word-fade block">la <em class="not-italic text-[var(--color-accent)]">IA</em> y el</span>
        <span class="word-fade block"><em class="not-italic text-[var(--color-accent)]">hardware</em>.</span>
      </h1>
      <p
        id="hero-sub"
        class="mt-6 text-base text-[var(--color-text-dim)] max-w-lg font-[var(--font-mono)] opacity-0"
        style="line-height: 1.7;"
      >
        12 proyectos validados en 2024–2026. Investigación estructural, visión por computadora, plataformas operativas y electrónica digital desde el sur del Perú.
      </p>
      <!-- CTA row -->
      <div id="hero-cta" class="mt-8 flex flex-wrap gap-4 font-[var(--font-mono)] text-sm opacity-0">
        <a
          href="/#proyectos"
          class="px-5 py-2.5 bg-[var(--color-accent)] text-black font-semibold tracking-wide uppercase text-xs hover:bg-[var(--color-accent-light)] transition-colors"
          style="letter-spacing: 0.1em;"
        >
          ver proyectos →
        </a>
        <a
          href="/sobre"
          class="px-5 py-2.5 border border-[var(--color-rule)] text-[var(--color-text-dim)] text-xs uppercase tracking-widest hover:text-[var(--color-accent)] hover:border-[var(--color-accent)] transition-colors"
        >
          sobre mí
        </a>
      </div>
    </div>

    <!-- Scroll indicator — bottom of viewport -->
    <div
      id="scroll-indicator"
      class="absolute bottom-0 left-0 right-0 flex justify-center pb-6 font-[var(--font-mono)] text-xs text-[var(--color-text-dim)] tracking-widest opacity-0"
      aria-hidden="true"
    >
      <span id="scroll-arrow" class="flex flex-col items-center gap-1">
        <span>scroll</span>
        <span class="block w-px h-8 bg-[var(--color-rule)]"></span>
        <span class="animate-bounce">↓</span>
      </span>
    </div>
  </div>

  <!-- Amber accent line along right edge of photo strip -->
  <div
    class="absolute top-0 h-full pointer-events-none"
    style="left: calc(38% + 1px); max-left: calc(560px + 1px); width: 1px; background: linear-gradient(to bottom, transparent 0%, var(--color-accent) 30%, var(--color-accent) 70%, transparent 100%); opacity: 0.35;"
    aria-hidden="true"
  ></div>
</section>

<style>
  .word-fade {
    opacity: 0;
    transform: translateY(20px);
  }
</style>
