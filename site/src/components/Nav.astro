---
const links = [
  { href: "/#proyectos", label: "proyectos" },
  { href: "/sobre",      label: "sobre" },
  { href: "/cv",         label: "cv" },
  { href: "/contacto",   label: "contacto" },
];
---
<nav
  class="fixed top-0 left-0 right-0 z-50 border-b border-[var(--color-rule)]"
  style="backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); background: rgba(2,6,23,0.65);"
>
  <div class="max-w-[var(--container-1100)] mx-auto px-6 py-3 flex items-center justify-between font-[var(--font-mono)] text-xs uppercase tracking-widest">
    <a href="/" class="text-[var(--color-text-dim)] hover:text-[var(--color-text)] transition-colors">
      / emanuel
    </a>
    <div class="flex gap-6 text-[var(--color-text-dim)]">
      {links.map((l) => (
        <a
          href={l.href}
          class="hidden sm:block hover:text-[var(--color-accent)] transition-colors"
        >
          {l.label}
        </a>
      ))}
      <!-- Mobile: only contacto pill -->
      <a
        href="/contacto"
        class="sm:hidden text-[var(--color-accent)] border border-[var(--color-accent)] px-3 py-1"
      >
        contacto
      </a>
    </div>
  </div>
</nav>
